# HTTP/3 is deliberately off. Caddy would otherwise advertise `alt-svc: h3` on
# every response, but QUIC never reaches it: docker-compose.yml publishes 443
# as TCP only and most hosts' firewalls pass TCP 443 only. Browsers that honour
# the hint then wait out a QUIC handshake on every request before falling
# back. `Alt-Svc: clear` makes browsers that already cached the hint drop it.
{
	servers {
		protocols h1 h2
	}
}

api.pixagram.com {
	header Alt-Svc clear
	encode zstd gzip
	reverse_proxy jussi_container:8080
}

http://api.pixagram.com {
	encode zstd gzip
	reverse_proxy jussi_container:8080
}
